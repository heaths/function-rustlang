{
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "ignorePaths": [
    ".cspell.json",
    ".devcontainer/**",
    ".funcignore"
  ],
  "words": [
    "bicepparam",
    "clippy",
    "customhandler",
    "funcignore",
    "functionapp",
    "reqwest",
    "rustfmt",
    "rustlang",
    "rustup"
  ],
  "overrides": [
    {
      "filename": ".github/workflows/**",
      "words": [
        "codeowners",
        "dwarnings",
        "rustflags"
      ]
    },
    {
      "filename": "azure.yaml",
      "words": [
        "postrestore",
        "predeploy",
        "postup"
      ]
    },
    {
      "filename": "infra/**",
      "words": [
        "contentazurefileconnectionstring",
        "contentshare",
        "serverfarms",
        "ragrs",
        "westus"
      ]
    },
    {
      "filename": "**/*.md",
      "dictionaries": [
        "rust"
      ]
    }
  ]
}
